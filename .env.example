# Set variables in the server process before starting. This file is NOT loaded automatically.
PRAXIS_DATA_DIR=.praxis
# Optional server API authentication (the current browser UI is local-only and does not supply a bearer token).
# PRAXIS_API_TOKEN=
# NVIDIA inference is optional, never simulated.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_API_KEY=
# Cloud loopback is not your Windows machine. Use a reachable, authorized HTTPS service.
# NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# NIGHTSHIFT_MODEL=
# NIGHTSHIFT_API_KEY=
# PRAXIS_SANDBOX_IMAGE=python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f
# Browser tests use system Chromium by default.
# CHROMIUM_PATH=/usr/bin/chromium

# Optional private hosted-demo gate (shared demo access, not multi-tenant identity).
# PRAXIS_DEMO_PASSWORD=
# PRAXIS_SESSION_SECRET=
# PRAXIS_SECURE_COOKIES=1
# PRAXIS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-api.onrender.com
# PRAXIS_SERVE_WEB=1
# PRAXIS_WEB_DIR=frontend/dist
# Vercel serverless proxy only; never prefix with VITE_.
# PRAXIS_BACKEND_URL=https://your-api.onrender.com
# Meterless Runtime requires a real token even on localhost; rt-local is rejected.
